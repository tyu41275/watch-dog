# No value has a default. Copy to .dev.vars only for local feature work.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SIGNING_KEY=
# Server-only Google Safe Browsing v5 key. There is no default and it must not
# enter client assets. Non-commercial use and raw-URL disclosure are required.
GOOGLE_SAFE_BROWSING_ENABLED=false
GOOGLE_SAFE_BROWSING_API_KEY=
