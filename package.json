{
  "name": "watch-dog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run check:protocol && tsc",
    "browser:acceptance": "playwright test --config=playwright.config.mjs",
    "browser:record": "playwright test --config=playwright.recording.config.mjs",
    "check:protocol": "node scripts/sync-protocol.mjs --check",
    "dev": "npx --yes wrangler@4.127.1 dev",
    "sync:protocol": "node scripts/sync-protocol.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "wrangler": "4.127.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "parse5": "8.0.1",
    "tldts": "7.4.11"
  }
}
